# Copy to ignored work/astra.env; values are literal, no shell expansion or quotes.
ASTRA_MODEL_URL=http://127.0.0.1:18767
# Match the alias reported by /v1/models. Qwen, Llama, Gemma require actual files/server.
ASTRA_MODEL_ALIAS=qwen2.5-1.5b-local
ASTRA_MODEL_TOKEN=
ASTRA_MAX_TOKENS=384
ASTRA_MODEL_READ_TIMEOUT=120
# Optional local internal-review gate. Generate independently on each PC (>=24 chars).
ASTRA_REVIEW_KEY=
# Trained local token classifier directory, NOT the e5 retrieval model.
ASTRA_DETECTOR_PATH=
ASTRA_DETECTOR_THRESHOLD=0.5
ASTRA_DETECTOR_LENGTH=512
ASTRA_DETECTOR_AGG=min
ASTRA_DETECTOR_DEVICE=cpu
